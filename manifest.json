{
  "manifest_version": 3,
  "name": "ScreenGrabber for Context",
  "version": "1.0.0",
  "description": "High-resolution product screen capture and rich AI-ready semantic context extraction to a local directory.",
  "permissions": [
    "sidePanel",
    "debugger",
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open ScreenGrabber"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
